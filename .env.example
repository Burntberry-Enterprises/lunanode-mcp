# LunaNode credentials — create keys in the panel: https://dynamic.lunanode.com/panel/api
LUNANODE_API_ID=your-api-id
LUNANODE_API_KEY=your-128-char-api-key

# Optional gating. Unset = tier off. true/1 = whole tier. Comma-separated tool names = only those.
# LUNANODE_ENABLE_WRITES=true
# LUNANODE_ENABLE_DELETES=vm_delete,volume_delete
